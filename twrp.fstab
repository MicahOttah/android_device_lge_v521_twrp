# TWRP fstab for the LG G Pad X 8.0 (V521).
#
# TWRP's own format (v1): <mount point> <file system> <device> [flags]
# This is NOT the AOSP fstab used by the ROM (recovery.fstab) - TWRP parses
# the columns in a different order.
#
# Based on the fstab of the TWRP 3.1.1 image that is known to work on this
# device (recovery-backup/twrp-3.1.1-0-highridas-v521.img), plus the extra
# partitions from the AOSP recovery.fstab.

/boot		emmc		/dev/block/bootdevice/by-name/boot
/cache		ext4		/dev/block/bootdevice/by-name/cache
/data		ext4		/dev/block/bootdevice/by-name/userdata	flags=encryptable=/dev/block/bootdevice/by-name/encrypt
/recovery	emmc		/dev/block/bootdevice/by-name/recovery		flags=backup=1
/system		ext4		/dev/block/bootdevice/by-name/system		flags=backup=1
/persistent	emmc		/dev/block/bootdevice/by-name/persistent
/persist	ext4		/dev/block/bootdevice/by-name/persist		flags=backup=1
/sns		ext4		/dev/block/bootdevice/by-name/sns
/drm		ext4		/dev/block/bootdevice/by-name/drm
/mpt		ext4		/dev/block/bootdevice/by-name/mpt
/firmware	vfat		/dev/block/bootdevice/by-name/modem		flags=display="Firmware";backup=1;mounttodecrypt;fsflags=context=u:object_r:firmware_file:s0
/external_sd	vfat		/dev/block/mmcblk1p1 /dev/block/mmcblk1		flags=storage;wipeingui;removable
/usb-otg	vfat		/dev/block/sda1 /dev/block/sda			flags=display="USB-OTG";storage;wipeingui;removable
